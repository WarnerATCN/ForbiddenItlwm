+// Lilu findPattern compares (data & mask) with the UNMASKED needle.
+// A wildcard in the mask therefore requires a zero byte in the needle too.
+// Keep the documented original arrays intact and normalize a private copy.
+template <size_t N>
+static bool patchAdvsetsMasked(const void *data, size_t size,
+    const uint8_t (&find)[N], const uint8_t (&findMask)[N],
+    const uint8_t (&replace)[N], const uint8_t (&replaceMask)[N]) {
+    uint8_t needle[N];
+    for (size_t i = 0; i < N; i++)
+        needle[i] = find[i] & findMask[i];
+    return KernelPatcher::findAndReplaceWithMask(const_cast<void *>(data), size,
+        needle, N, findMask, N, replace, N, replaceMask, N);
+}
 
